# MyElectricalData - Client Mode Configuration
# Copy this file and fill in your credentials
#
# Production (images ghcr) : Docker Compose reads .env
#   cp .env.local-client.example .env
#   docker compose -f docker-compose.client.yml up -d  # one container, SQLite file (recommended)
# Existing two-container installs : docker-compose.sqlite.yml (SQLite), docker-compose.yml (bundled PostgreSQL)
#
# Development (make up / make dev, dev/docker-compose.yml) :
#   cp .env.local-client.example .env.local-client

# ===========================================
# REQUIRED - MyElectricalData API Credentials
# ===========================================
# Get these from your account at https://www.v2.myelectricaldata.fr
# Go to Settings > API to find your client_id and client_secret

MED_CLIENT_ID=cli_xxxxxxxxxxxxxxxxxxxxxxxxx
MED_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# OPTIONAL - Override defaults if needed
# ===========================================

# MyElectricalData API URL (default: production)
# MED_API_URL=https://www.v2.myelectricaldata.fr/api

# PostgreSQL password of the bundled postgres service, docker-compose.yml only (set it before the first start:
# the database keeps the password it was created with). Letters, digits, - _ . ~ only:
# it is inserted as is in DATABASE_URL
# POSTGRES_PASSWORD=change-me

# JWT Secret Key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# If not set, a random key is generated (sessions lost on restart)
# SECRET_KEY=your-secure-random-key

# Debug mode (default: false)
# DEBUG=false

# Timezone (default: Europe/Paris)
# TZ=Europe/Paris

# ===========================================
# EXPORT CONFIGURATIONS
# ===========================================
# Export settings (Home Assistant, MQTT, VictoriaMetrics, Jeedom)
# are configured in the web interface at http://localhost:8100/export
# and stored in the PostgreSQL database.
#
# No environment variables needed for exports!
